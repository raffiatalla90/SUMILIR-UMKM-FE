# ─── Vue SPA + Laravel Backend (.htaccess for public_html/) ─────────────────

# Block access to sensitive files
<FilesMatch "(\.env|\.env\..*|composer\.json|composer\.lock|package\.json|pnpm-lock\.yaml|\.git)$">
    Order allow,deny
    Deny from all
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ─── Skip /backend routes (handled by Laravel's own .htaccess) ──────────
    RewriteRule ^backend(/.*)?$ - [L]

    # ─── Vue SPA fallback ───────────────────────────────────────────────────
    # If the request is not an existing file or directory, serve index.html
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
